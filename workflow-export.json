    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n\n  const data = item.json;\n\n  const resume = Number(data.resume_match_score || 0);\n  const career = Number(data.career_alignment_score || 0);\n  const market = Number(data.market_opportunity_score || 0);\n  const salary = Number(data.salary_score || 0);\n\n  data.final_score = Math.round(\n    resume * 0.50 +\n    career * 0.30 +\n    market * 0.15 +\n    salary * 0.05\n  );\n\n  if (data.final_score >= 85) {\n    data.priority = \"P1\";\n  } else if (data.final_score >= 75) {\n    data.priority = \"P2\";\n  } else {\n    data.priority = \"P3\";\n  }\n\n  results.push({\n    json: data\n  });\n}\n\nreturn results;"
      },
