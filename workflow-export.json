      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n\n  const response = item.json.content[0].text;\n\n  const jsonMatch = response.match(/\\{[\\s\\S]*\\}/);\n\n  if (!jsonMatch) {\n    continue;\n  }\n\n  results.push({\n    json: JSON.parse(jsonMatch[0])\n  });\n}\n\nreturn results;"
      },
