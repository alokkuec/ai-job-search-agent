          "values": [
            {
              "content": "=You are an executive recruiter.\n\nCandidate Resume:\n{{ $json.content }}\n\n\nJob Details:\n{{ $('Limit').item.json.title }}\n{{ $('Limit').item.json.link }}\n{{ $('Limit').item.json.content }}\n\nCompany Research:\n\n{{ JSON.stringify($json) }}\n\nAnalyze:\n\n1. Resume Match Score (0-100)\n2. Top Strengths\n3. Missing Skills\n4. Resume Gaps\n5. Interview Risk Areas\n6. Should candidate apply?\n\n#Match score rules\n90-100 = Exceptional match\n80-89  = Strong match\n70-79  = Good match\n60-69  = Stretch\n<60    = Ignore\n\n# Missing skills\nReturn maximum 3 missing skills.\nEach skill max 10 words\n\n#Return JSON only.\n\n{\n \"company\": \"Microsoft\",\n  \"title\": \"Product Manager\"\n \"resume_match_score\": 0,\n \"apply_now\": true,\n\"salary_estimate\": \"$180k-$220k\",\n  \"remote_friendly\": true,\n \"strengths\": [],\n \"missing_skills\": [],\n \"resume_gaps\": [],\n \"interview_risks\": []\n}\n\n# Return ONLY valid JSON.\n\nDo NOT use markdown.\nDo NOT wrap the response in ```json.\nDo NOT include explanations.\ncompany: mandatory\nIf company cannot be identified, return \"Unknown\"\n"
            }
          ]
        },
