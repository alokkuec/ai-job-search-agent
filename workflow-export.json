      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const response = item.json.content[0].text;\n\n  const cleaned = response\n    .replace(/```json/g, '')\n    .replace(/```/g, '')\n    .trim();\n\n  results.push({\n    json: JSON.parse(cleaned)\n  });\n}\n\nreturn results;"
      },
